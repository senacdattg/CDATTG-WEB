# ===========================================
# CDATTG - Docker / Producción
# Copiar a .env y ajustar valores.
# ===========================================

# Base de datos PostgreSQL
DB_USER=cdattg
DB_PASSWORD=cambiar-en-produccion
DB_NAME=cdattg_web
# Puerto publicado en el host. En VPS con varios proyectos Docker, 5432 suele estar ocupado; use 5433.
DB_PORT=5433
DB_SSLMODE=disable
DB_TIMEZONE=America/Bogota

# Backend (JWT)
JWT_SECRET=generar-clave-secreta-minimo-256-bits-para-produccion
JWT_EXPIRATION_HOURS=24

# CORS: orígenes permitidos (URL del frontend en HTTPS)
CORS_ALLOWED_ORIGINS=https://cdattg.dataguaviare.com.co

# URL de la API usada por el frontend en tiempo de build
VITE_API_BASE_URL=https://apicdattg.dataguaviare.com.co/api

# Reglas de negocio (backend)
# Modo transitorio: instructor asignado puede tomar asistencia sin restricción de día/horario.
# Festivos nacionales y días sin formación por sede (PARO) siguen aplicando.
# Volver a false cuando la programación por instructor/día esté estabilizada.
NEGOCIO_RELAXAR_RESTRICCION_ASISTENCIA=false

# Modo transitorio: permite programar instructores aunque se solapen día/horario en otra ficha.
# Volver a false cuando la reorganización de programación esté estabilizada.
NEGOCIO_RELAXAR_COLISION_HORARIO_INSTRUCTOR=false

# ===========================================
# SofiaPlus (módulo Complementarios: verificación pública de aspirantes)
# ===========================================
# URL pública de consulta (sin login). Por defecto: Consultar Inscripciones en SofiaPlus.
SOFIA_PUBLIC_URL=http://senasofiaplus.edu.co/sofia-public/inscripcion/consultarinscripciones/buscadorInscripcionesUsuario.faces
# Clave para cifrar credenciales SofiaPlus guardadas en la app (legado, ya no obligatoria para verificar).
SOFIA_ENC_KEY=
# false = navegador con Xvfb en Docker (requerido para evitar ERROR 402 de SofiaPlus)
SOFIA_HEADLESS=false
SOFIA_TIMEOUT_SEGUNDOS=60
SOFIA_DIAGNOSTICO=true
SOFIA_SCRAPER_URL=http://sofia-scraper:8090
